{
    "name": "protoplus",
    "version": "1.14.0",
    "description": "A multi-environment module that expands JavaScript's prototype methods, global helper functions and others.",
    "main": "protoplus.cjs",
    "module": "protoplus.mjs",
    "exports": {
        ".": {
            "import": "./protoplus.mjs",
            "require": "./protoplus.cjs",
            "default": "./protoplus.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "protoplus.js",
        "protoplus.mjs",
        "protoplus.cjs"
    ],
    "type": "module",
    "scripts": {
        "build": "node ./build/constructor.js"
    },
    "keywords": [
        "node",
        "bun",
        "deno",
        "browser",
        "webjs",
        "multienvironment",
        "crossenvironment",
        "prototype",
        "dx"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sophb-chan/protoplus.git"
    },
    "bugs": "https://github.com/sophb-chan/protoplus/issues",
    "homepage": "https://github.com/sophb-chan/protoplus#readme",
    "author": "sophb.chan <sophb.chan@proton.me>",
    "license": "MIT",
    "devDependencies": {
        "@prettier/sync": "^0.6.1",
        "prettier": "^3.9.10"
    }
}
